<Project>
  <PropertyGroup>
    <Version>1.2.0</Version>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <Target Name="RequireSptRoot" BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(SptRoot)' == '' Or !Exists('$(SptRoot)/SPT_Runtime/SPTarkov.Server.Core.dll')">
    <Error Text="Set SptRoot to an SPT 4.1.6 installation (the folder containing SPT_Runtime)." />
  </Target>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
